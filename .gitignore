# ── Android build outputs ────────────────────────────────────────────
# Gradle root was flattened from android/ to the project root — cover both.
.gradle/
.kotlin/
build/
android/build/
android/app/build/
local.properties
android/local.properties
*.iml

# ── Android Studio / IntelliJ ────────────────────────────────────────
.idea/
.DS_Store

# ── Gradle wrapper (keep gradlew + wrapper jar, ignore caches) ───────
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat
!android/gradle/wrapper/gradle-wrapper.jar
!android/gradle/wrapper/gradle-wrapper.properties
!android/gradlew
!android/gradlew.bat

# ── Model files — too large for git ─────────────────────────────────
*.onnx
*.onnx.data
*.gguf
*.task
*.litertlm
*.tflite
*.tar.gz

# ── Python env / cache ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── macOS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets / keys ───────────────────────────────────────────────────
*.keystore
*.jks
google-services.json

# ── Claude Code local settings (personal, machine-specific) ──────────
.claude/settings.local.json
