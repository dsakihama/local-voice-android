<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ────────────────────────────────────────────── -->

    <!-- Audio capture for STT -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service for inference (keeps alive during processing) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Foreground service that keeps the floating bubble alive across apps -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- System overlay: FAB floats above all other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Post-processing notification (Android 13+) for clipboard fallback -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Read clipboard to detect target app context (Android 13+, user-triggered only) -->
    <!-- Note: clipboard read is restricted in Android 13+ to user-triggered actions only -->

    <!-- Vibration for haptic feedback on FAB tap -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ── Package visibility (Android 11+) ─────────────────────────── -->
    <!-- Required to query installed packages via PackageManager.getPackageInfo() -->
    <queries>
        <!-- Share-sheet targets resolve via ACTION_SEND text/plain (package visibility, API 30+) -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Obsidian new-note deep link probe -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="obsidian" />
        </intent>
        <!-- AI -->
        <package android:name="com.anthropic.claude" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="ai.perplexity.app" />
        <package android:name="com.microsoft.copilot" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="ai.x.grok" />
        <!-- Comms -->
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.android.messaging" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.microsoft.office.outlook" />
        <package android:name="com.whatsapp" />
        <package android:name="com.Slack" />
        <package android:name="com.discord" />
        <package android:name="org.telegram.messenger" />
        <!-- PKB -->
        <package android:name="md.obsidian" />
        <package android:name="notion.id" />
        <package android:name="com.microsoft.onenote" />
    </queries>

    <!-- ── Application ─────────────────────────────────────────────── -->

    <application
        android:name=".VoiceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalVoice"
        >

        <!-- Main entry activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LocalVoice.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating mic bubble: always-on system overlay -->
        <service
            android:name=".overlay.VoiceOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_dictation_overlay" />
        </service>

        <!-- Accessibility Service: text injection into target apps -->
        <service
            android:name=".service.VoiceAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
